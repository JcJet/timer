#!/usr/bin/env bash
set -u

running=1
start=$(date +%s)
paused_total=0
pause_start=0

last_shown=-1
last_running=-1

hide_cursor() {
  # tput предпочтительнее, но если его нет — fallback на escape
  if command -v tput >/dev/null 2>&1; then
    tput civis 2>/dev/null || true
  else
    printf "\e[?25l"
  fi
}

show_cursor() {
  if command -v tput >/dev/null 2>&1; then
    tput cnorm 2>/dev/null || true
  else
    printf "\e[?25h"
  fi
}

cleanup() {
  stty sane 2>/dev/null || true
  show_cursor
  printf "\n"
}
trap cleanup EXIT INT TERM

clear
hide_cursor

# raw-ish mode: no echo, no canonical (no Enter)
stty -echo -icanon 2>/dev/null || true

printf "space=pause/resume | r=reset | q=quit\n\n"

while true; do
  # ждём клавишу максимум 0.1s, иначе идём дальше
  if IFS= read -rsn1 -t 0.1 key 2>/dev/null; then
    case "$key" in
      " ")
        if (( running )); then
          running=0
          pause_start=$(date +%s)
        else
          running=1
          now=$(date +%s)
          paused_total=$((paused_total + now - pause_start))
        fi
        ;;
      r|R)
        running=1
        start=$(date +%s)
        paused_total=0
        pause_start=0
        ;;
      q|Q)
        exit 0
        ;;
    esac
  fi

  now=$(date +%s)
  if (( running )); then
    cur=$((now - start - paused_total))
    suffix="        "
  else
    cur=$((pause_start - start - paused_total))
    suffix=" [PAUSE]"
  fi

  if (( cur != last_shown || running != last_running )); then
    last_shown=$cur
    last_running=$running
    printf "\r%02d:%02d:%02d%s" $((cur/3600)) $(((cur%3600)/60)) $((cur%60)) "$suffix"
  fi
done
