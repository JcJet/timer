#!/usr/bin/env bash
set -u

running=1
start=$(date +%s)
paused_total=0
pause_start=0

show_minutes=0   # toggle with 'm'
last_shown=-1
last_running=-1
last_mode=-1

hide_cursor() {
  if command -v tput >/dev/null 2>&1; then
    tput civis 2>/dev/null || true
  else
    printf "\e[?25l"
  fi
}

show_cursor() {
  if command -v tput >/dev/null 2>&1; then
    tput cnorm 2>/dev/null || true
  else
    printf "\e[?25h"
  fi
}

cleanup() {
  stty sane 2>/dev/null || true
  show_cursor
  printf "\n"
}
trap cleanup EXIT INT TERM

clear
hide_cursor
stty -echo -icanon 2>/dev/null || true

# намеренно НЕ пишем про 'm', чтобы не захламлять интерфейс
printf "space=pause/resume | r=reset | q=quit\n\n"

while true; do
  if IFS= read -rsn1 -t 0.1 key 2>/dev/null; then
    case "$key" in
      " ")
        if (( running )); then
          running=0
          pause_start=$(date +%s)
        else
          running=1
          now=$(date +%s)
          paused_total=$((paused_total + now - pause_start))
        fi
        ;;
      r|R)
        running=1
        start=$(date +%s)
        paused_total=0
        pause_start=0
        ;;
      m|M)
        # toggle display mode: HH:MM:SS <-> minutes
        if (( show_minutes )); then show_minutes=0; else show_minutes=1; fi
        ;;
      q|Q)
        exit 0
        ;;
    esac
  fi

  now=$(date +%s)
  if (( running )); then
    cur=$((now - start - paused_total))
    pause_tag=""
  else
    cur=$((pause_start - start - paused_total))
    pause_tag=" [PAUSE]"
  fi

  # redraw if time or state or mode changed
  if (( cur != last_shown || running != last_running || show_minutes != last_mode )); then
    last_shown=$cur
    last_running=$running
    last_mode=$show_minutes

    if (( show_minutes )); then
      mins=$(((cur + 30) / 60))   # минуты, округление до ближайшей
      out="${mins}m${pause_tag}"
    else
      out=$(printf "%02d:%02d:%02d%s" $((cur/3600)) $(((cur%3600)/60)) $((cur%60)) "$pause_tag")
    fi

    # фиксированная ширина, чтобы затирать хвост при смене режима
    printf "\r%-32s" "$out"
  fi
done
